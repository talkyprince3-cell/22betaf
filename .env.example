# ---------------------------------------------------------------------------
# Betlixx configuration. Everything deployment-specific is an environment
# variable; copy this to .env.local and fill in what your deployment needs.
# The app degrades rather than crashing when any of these is missing.
# ---------------------------------------------------------------------------

# Database. Without these the app degrades to upstream fixtures only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Upstream fixtures and odds. Without it the feed returns custom matches only.
API_FOOTBALL_KEY=

# Enables the admin console. Unset means the console is disabled entirely.
ADMIN_PASSWORD=

# One-time welcome bonus on the first confirmed deposit.
FIRST_DEPOSIT_BONUS=100

# Per-country minimum deposit and verification amount.
MIN_FIRST_DEPOSIT_GH=200
VERIFICATION_AMOUNT_GH=300
MIN_FIRST_DEPOSIT_NG=500
VERIFICATION_AMOUNT_NG=10000

# Per-country withdrawal gate. A count of 0 reverts that market to the older
# cumulative-total rule.
WITHDRAW_QUALIFY_COUNT_GH=3
WITHDRAW_QUALIFY_AMOUNT_GH=300
WITHDRAW_QUALIFY_COUNT_NG=3
WITHDRAW_QUALIFY_AMOUNT_NG=10000

# SMS delivery and the sender name players see.
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=Betlixx

# The WhatsApp line on the deposit screen.
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Bearer token the settlement cron must present.
CRON_SECRET=

# Caps on a partner crediting their own betting wallet. This is an agent float,
# not a deposit — it moves no money through a payment rail, so it is bounded and
# every credit is written to the operator's ledger.
PARTNER_CREDIT_MAX=5000
PARTNER_CREDIT_DAILY_MAX=20000

# --- Gateway credentials, per rail -----------------------------------------

# Flutterwave v3: Ghana mobile money, and the hosted checkout kept as a
# fallback. The secret key is the standing key from the dashboard.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
# Read by nothing today. Only a browser-side (inline) checkout would want it.
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=

# Flutterwave v4: the card checkout at /checkout. v4 authenticates with OAuth
# client credentials instead of a secret key, and the encryption key is what
# the card fields are sealed with before they leave us. All three come from the
# same "V4 Live API keys" page; the secret is shown once, so keep it somewhere
# you can find it again.
FLUTTERWAVE_CLIENT_ID=
FLUTTERWAVE_CLIENT_SECRET=
FLUTTERWAVE_ENCRYPTION_KEY=
# "live" points at production. Anything else stays on the sandbox, which is
# where you want to be until a real card has been through it end to end.
FLUTTERWAVE_ENV=sandbox

KORAPAY_SECRET_KEY=

MOOLRE_API_KEY=
MOOLRE_API_USER=
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_WEBHOOK_SECRET=

PAYSTACK_SECRET_KEY=
